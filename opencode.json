{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/project/OpenCode-DevKit-Project.md"
  ],
  "permission": {
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "lsp": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "python3 *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "curl *": "allow",
      "mkdir *": "allow",
      "source .devkit/bin/activate && *": "allow",
      "npx markdownlint-cli2 *": "allow"
    }
  },
  "watcher": {
    "ignore": [".devkit/**", "__pycache__/**"]
  }
}
